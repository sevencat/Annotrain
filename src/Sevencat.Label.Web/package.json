{
  "name": "annotrain-web",
  "version": "0.1.0",
  "description": "Annotrain Web 标注端（Quasar + Konva/Leaflet，单文件构建）",
  "productName": "Annotrain",
  "author": "sevencat <bastet.wang@aliyun.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "build:server": "quasar build && node scripts/build-server-page.mjs",
