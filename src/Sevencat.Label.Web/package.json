    "@quasar/extras": "^2.1.0",
    "konva": "^10.9.1",
    "leaflet": "^1.9.4",
    "pinia": "^4.0.2",
    "quasar": "^2.35.2",
    "vue": "^3.5.22",
    "vue-konva": "^4.0.1",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
