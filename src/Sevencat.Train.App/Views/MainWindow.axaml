<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sevencat.Train.App.ViewModels"
        xmlns:controls="using:Sevencat.Train.App.Controls"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:l="using:Sevencat.Train.App.Localization"
        xmlns:loc="using:Sevencat.Core.Localization"
        x:Class="Sevencat.Train.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.png"
        Width="1080" Height="760"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8" RowSpacing="8">

    <!-- 顶栏：与标注端同构（标题 + 状态徽标 / 服务入口 / 语言 / 模拟数据 · 关于 · 日志） -->
    <Border Grid.Row="0" Classes="card" Padding="12,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{l:Loc Train.Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />

          <Border CornerRadius="9" Padding="8,1" Background="#1F16A34A" VerticalAlignment="Center"
                  IsVisible="{Binding ShowRunningBadge}">
            <TextBlock Text="{l:Loc Train.Running}" FontSize="13" Foreground="#16A34A" />
          </Border>
          <Border CornerRadius="9" Padding="8,1" Background="#1FF59E0B" VerticalAlignment="Center"
                  IsVisible="{Binding ShowPausedBadge}">
            <TextBlock Text="{l:Loc Train.Paused}" FontSize="13" Foreground="#B45309" />
          </Border>
          <Border CornerRadius="9" Padding="8,1" Background="#14000000" VerticalAlignment="Center"
                  IsVisible="{Binding ShowReadyBadge}">
            <TextBlock Text="{l:Loc Train.Ready}" FontSize="13" Opacity="0.7" />
          </Border>
        </StackPanel>

        <!-- 训练服务入口：端口 + 可打开的地址 + 打开（Web 端接入后即可用） -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding ServicePortText}" FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ServiceUrl}" FontSize="13" Opacity="0.75" VerticalAlignment="Center"
                     FontFamily="Consolas,Menlo,monospace" TextTrimming="CharacterEllipsis" />
          <Button Content="{l:Loc Train.OpenService}" Padding="10,2" FontSize="13" Click="OnOpenService" />
        </StackPanel>

        <ComboBox Grid.Column="2" x:Name="LanguageBox"
                  ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                  MinWidth="124" VerticalAlignment="Center"
                  ToolTip.Tip="{l:Loc Common.Language}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="loc:LanguageOption">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Grid.Column="3" Content="{l:Loc Train.Simulate}" Click="OnSimulate"
                ToolTip.Tip="{l:Loc Sim.Title}" />
        <Button Grid.Column="4" Content="{l:Loc Train.About}" Click="OnAbout" />
        <Button Grid.Column="5" Content="{l:Loc Train.Log}" Click="OnOpenLog" />
      </Grid>
    </Border>

    <!-- 第二行：数据集 + 训练控制 + 只读参数（同一排） / 输出目录 + 数据集统计 -->
    <Border Grid.Row="1" Classes="card" Padding="12,10">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">

        <!-- 第一行：打开数据集 + 训练控制 + 参数，依次排开 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{l:Loc Train.Dataset}" Classes="caption" VerticalAlignment="Center" />
            <Button Content="YOLO" Padding="10,2" FontSize="13" Click="OnOpenYolo"
                    ToolTip.Tip="{l:Loc Train.OpenYoloTip}" />
            <Button Content="RF-DETR" Padding="10,2" FontSize="13" Click="OnOpenRfDetr"
                    ToolTip.Tip="{l:Loc Train.OpenRfDetrTip}" />
            <Button Content="TinyLabel" Padding="10,2" FontSize="13" Click="OnOpenTinyLabel"
                    ToolTip.Tip="{l:Loc Train.OpenTinyLabelTip}" />
            <Button Content="{l:Loc Train.Start}" IsEnabled="{Binding CanStart}" Click="OnStart" />
            <Button Content="{l:Loc Train.Pause}" IsEnabled="{Binding CanPause}" Click="OnPause" />
            <Button Content="{l:Loc Train.Resume}" IsEnabled="{Binding CanResume}" Click="OnResume" />
            <Button Content="{l:Loc Train.Finish}" IsEnabled="{Binding CanFinish}" Click="OnStop" />
            <Button Content="{l:Loc Train.Detect}" Click="OnDetect"
                    ToolTip.Tip="{l:Loc Train.DetectTip}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="epochs" Classes="caption" />
            <TextBlock Text="{Binding EpochsText}" Classes="value" MinWidth="26" />
            <TextBlock Text="batch" Classes="caption" Margin="10,0,0,0" />
            <TextBlock Text="{Binding BatchSizeText}" Classes="value" MinWidth="20" />
            <TextBlock Text="imgsz" Classes="caption" Margin="10,0,0,0" />
            <TextBlock Text="{Binding ImageSizeText}" Classes="value" MinWidth="30" />
            <Button Content="{l:Loc Train.Params}" Padding="10,2" FontSize="13" Margin="4,0,0,0"
                    Click="OnEditParams" ToolTip.Tip="{l:Loc Train.ParamsTip}" />
          </StackPanel>
        </Grid>

        <!-- 第二行：输出目录（只显示，修改按钮紧跟路径）+ 数据集统计 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{l:Loc Train.OutputDir}" Classes="caption"
                       ToolTip.Tip="{l:Loc Train.OutputDirTip}" />
            <TextBlock Text="{Binding OutputDirectory}" Classes="value" Opacity="0.8" MaxWidth="230"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OutputDirectory}" />
            <Button Content="{l:Loc Train.Set}" Padding="10,2" FontSize="13" Margin="2,0,0,0"
                    Click="OnPickOutput" ToolTip.Tip="{l:Loc Train.OutputDirTip}" />
            <Button Content="{l:Loc Train.Open}" Padding="10,2" FontSize="13" Margin="2,0,0,0"
                    Click="OnOpenOutput" ToolTip.Tip="{l:Loc Train.OpenOutputTip}" />
            <TextBlock Text="{l:Loc Train.Product}" Classes="caption" Margin="10,0,0,0"
                       ToolTip.Tip="{l:Loc Train.ProductTip}" />
            <TextBlock Text="best.safetensors" Classes="value" Opacity="0.8"
                       ToolTip.Tip="{l:Loc Train.ProductTip}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="4,0"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding DatasetPath}" FontSize="12" Opacity="0.5" MaxWidth="190"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding DatasetPath}" />
            <TextBlock Text="{Binding DatasetSummary}" FontSize="13" Opacity="0.75"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding DatasetStats}" FontSize="13" Opacity="0.55"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>

        <!-- 第三行：训练成什么模型 + 导出 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{l:Loc Train.Model}" Classes="caption" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding ModelFamilies}" SelectedItem="{Binding SelectedModel}"
                    MinWidth="120" Height="28" FontSize="13">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModelOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="{l:Loc Train.ExportOnnx}" Padding="10,2" FontSize="13" Click="OnExportOnnx"
                  ToolTip.Tip="{l:Loc Train.ExportOnnxTip}" />
          <Button Content="{l:Loc Train.ExportWeights}" Padding="10,2" FontSize="13" Click="OnExportWeights"
                  ToolTip.Tip="{l:Loc Train.ExportWeightsTip}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 中间：训练曲线（LiveCharts：mAP 走左轴、loss 走右轴） -->
    <Border Grid.Row="2" Classes="card" Padding="6" ClipToBounds="True">
      <Grid>
        <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" />
        <TextBlock Text="{l:Loc Train.ChartIdle}" FontSize="14" Opacity="0.55"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !HasChartData}" />
      </Grid>
    </Border>

    <!-- 下排：进度 + 状态 -->
    <Border Grid.Row="3" Classes="card" Padding="12,10">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <ProgressBar Grid.Row="0" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding RunInfo}" FontSize="13" Opacity="0.6" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>

</Window>
