<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sevencat.Train.App.ViewModels"
        xmlns:l="using:Sevencat.Train.App.Localization"
        x:Class="Sevencat.Train.App.Views.SimulationWindow"
        x:DataType="vm:SimulationViewModel"
        Title="{l:Loc Sim.Title}"
        Width="700" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="20" Spacing="12">

    <TextBlock Text="{l:Loc Sim.Title}" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Text="{l:Loc Sim.Intro}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

    <!-- 尺寸 / 数量 -->
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="{l:Loc Sim.Width}" Classes="caption" />
      <NumericUpDown Value="{Binding ImageWidth}" Minimum="32" Maximum="4096"
                     Increment="32" FormatString="0" Width="110" />
      <TextBlock Text="×" Classes="caption" />
      <NumericUpDown Value="{Binding ImageHeight}" Minimum="32" Maximum="4096"
                     Increment="32" FormatString="0" Width="110" />

      <TextBlock Text="{l:Loc Sim.Count}" Classes="caption" Margin="12,0,0,0" />
      <NumericUpDown Value="{Binding ImageCount}" Minimum="1" Maximum="5000"
                     Increment="10" FormatString="0" Width="110" />
    </StackPanel>

    <!-- 划分 / 形状数 -->
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="{l:Loc Sim.ValPercent}" Classes="caption" />
      <NumericUpDown Value="{Binding ValPercent}" Minimum="0" Maximum="90"
                     Increment="5" FormatString="0" Width="110" />

      <TextBlock Text="{l:Loc Sim.MaxShapes}" Classes="caption" Margin="12,0,0,0" />
      <NumericUpDown Value="{Binding MaxShapes}" Minimum="1" Maximum="10"
                     Increment="1" FormatString="0" Width="110" />

      <TextBlock Text="{Binding ShapesHint}" FontSize="12" Opacity="0.55"
                 VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260" />
    </StackPanel>

    <!-- 保存格式 -->
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="{l:Loc Sim.Format}" Classes="caption" />
      <ComboBox ItemsSource="{Binding Targets}"
                SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                MinWidth="200" VerticalAlignment="Center">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TargetOption">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <!-- YOLO / RF-DETR：一个输出目录 -->
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsFolderTarget}">
      <TextBlock Text="{l:Loc Sim.Output}" Classes="caption" Width="64" />
      <TextBox Text="{Binding OutputDirectory}" Width="470" FontSize="13"
               MinHeight="32" VerticalContentAlignment="Center" />
      <Button Content="{l:Loc Sim.Browse}" Padding="10,2" FontSize="13" Click="OnBrowseOutput" />
    </StackPanel>

    <!-- TinyLabel：库 + 数据目录（选库后目录自动带出，可改） -->
    <StackPanel Spacing="8" IsVisible="{Binding IsTinyLabel}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{l:Loc Sim.Database}" Classes="caption" Width="64" />
        <TextBox Text="{Binding DatabasePath}" Width="470" FontSize="13"
                 MinHeight="32" VerticalContentAlignment="Center" />
        <Button Content="{l:Loc Sim.Browse}" Padding="10,2" FontSize="13" Click="OnBrowseDatabase" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{l:Loc Sim.DataDir}" Classes="caption" Width="64" />
        <TextBox Text="{Binding DataDirectory}" Width="470" FontSize="13"
                 MinHeight="32" VerticalContentAlignment="Center" />
        <Button Content="{l:Loc Sim.Browse}" Padding="10,2" FontSize="13" Click="OnBrowseDataDirectory" />
      </StackPanel>

      <TextBlock Text="{l:Loc Sim.TinyHint}" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
    </StackPanel>

    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6"
                 IsVisible="{Binding IsBusy}" />

    <TextBlock Text="{Binding Status}" FontSize="13" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{l:Loc Sim.Generate}" Click="OnGenerate" IsEnabled="{Binding CanGenerate}" />
      <Button Content="{l:Loc Sim.Close}" Click="OnClose" />
    </StackPanel>
  </StackPanel>

</Window>
