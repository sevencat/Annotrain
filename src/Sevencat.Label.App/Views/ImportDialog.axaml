<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Sevencat.Label.App.Localization"
        x:Class="Sevencat.Label.App.Views.ImportDialog"
        Title="{l:Loc Import.Title}"
        Width="560" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="{l:Loc Import.Header}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="TargetText" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />

    <TextBlock Text="{l:Loc Import.Source}" FontWeight="SemiBold" Margin="0,4,0,0" />

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Grid.Column="0" x:Name="SourceBox"
               PlaceholderText="{l:Loc Import.SourcePlaceholder}" />
      <Button Grid.Column="1" Content="{l:Loc Common.Browse}" Click="OnBrowse" />
    </Grid>

    <TextBlock Text="{l:Loc Import.Format}" FontWeight="SemiBold" Margin="0,4,0,0" />

    <ComboBox x:Name="FormatBox" SelectedIndex="0" HorizontalAlignment="Stretch">
      <ComboBoxItem Content="{l:Loc Import.Auto}" />
      <ComboBoxItem Content="{l:Loc Export.FormatYolo}" />
      <ComboBoxItem Content="{l:Loc Export.FormatCoco}" />
    </ComboBox>

    <TextBlock Text="{l:Loc Import.ProjectName}" FontWeight="SemiBold" Margin="0,4,0,0" />

    <TextBox x:Name="NameBox" PlaceholderText="{l:Loc Import.NamePlaceholder}" />

    <TextBlock x:Name="HintText" Opacity="0.7" FontSize="12" TextWrapping="Wrap" MinHeight="18" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="{l:Loc Common.Cancel}" Click="OnCancel" IsCancel="True" />
      <Button Content="{l:Loc Import.Action}" Click="OnConfirm" IsDefault="True" />
    </StackPanel>
  </StackPanel>

</Window>
