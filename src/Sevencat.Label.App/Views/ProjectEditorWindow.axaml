<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Sevencat.Label.App.Localization"
        x:Class="Sevencat.Label.App.Views.ProjectEditorWindow"
        Title="{l:Loc Project.NewTitle}"
        Width="480" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="10">
    <TextBlock x:Name="HeaderText" Text="{l:Loc Project.NewTitle}" FontSize="16" FontWeight="SemiBold" />
    <TextBlock x:Name="HintText" Text="{l:Loc Project.NewHint}"
               Opacity="0.6" FontSize="12" TextWrapping="Wrap" />

    <TextBlock Text="{l:Loc Project.Name}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBox x:Name="NameBox" PlaceholderText="{l:Loc Project.NamePlaceholder}" MaxLength="128" />

    <TextBlock Text="{l:Loc Project.Note}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBox x:Name="DescriptionBox" AcceptsReturn="True" Height="88"
             TextWrapping="Wrap" PlaceholderText="{l:Loc Project.NotePlaceholder}" />

    <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" MinHeight="16" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button Content="{l:Loc Common.Cancel}" Click="OnCancel" IsCancel="True" />
      <Button x:Name="ConfirmButton" Content="{l:Loc Common.Create}" Click="OnConfirm" IsDefault="True" />
    </StackPanel>
  </StackPanel>

</Window>
