<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sevencat.Label.App.Views.ProjectEditorWindow"
        Title="新建项目"
        Width="480" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="新建项目" FontSize="16" FontWeight="SemiBold" />
    <TextBlock Text="新项目建在当前数据目录的 annotrain.db 里；图片可以之后导入或扫描。" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />

    <TextBlock Text="项目名" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBox x:Name="NameBox" PlaceholderText="例如：路面试跑 第一批" MaxLength="128" />

    <TextBlock Text="备注" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBox x:Name="DescriptionBox" AcceptsReturn="True" Height="88"
             TextWrapping="Wrap" PlaceholderText="可留空；导出 YOLO 的备注也会读这里" />

    <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" MinHeight="16" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button Content="取消" Click="OnCancel" IsCancel="True" />
      <Button Content="创建" Click="OnConfirm" IsDefault="True" />
    </StackPanel>
  </StackPanel>

</Window>
