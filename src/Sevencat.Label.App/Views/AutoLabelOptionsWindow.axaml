<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Sevencat.Label.App.Localization"
        x:Class="Sevencat.Label.App.Views.AutoLabelOptionsWindow"
        Title="{l:Loc AutoLabel.Title}"
        Width="540" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="{l:Loc AutoLabel.Title}" FontSize="16" FontWeight="SemiBold" />
    <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
               Text="{l:Loc AutoLabel.Description}" />

    <TextBlock Text="{l:Loc AutoLabel.ModelLabel}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Grid.Column="0" x:Name="ModelBox" PlaceholderText="{l:Loc AutoLabel.ModelPlaceholder}" />
      <Button Grid.Column="1" Content="{l:Loc Common.Browse}" Click="OnBrowse" />
    </Grid>

    <TextBlock Text="{l:Loc AutoLabel.ConfidenceLabel}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <NumericUpDown x:Name="ConfidenceBox" Minimum="0.05" Maximum="0.95"
                   Increment="0.05" Value="0.25" FormatString="0.00" />

    <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap"
               Text="{l:Loc AutoLabel.ClassHint}" />

    <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" MinHeight="16" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button Content="{l:Loc Common.Cancel}" Click="OnCancel" IsCancel="True" />
      <Button Content="{l:Loc Common.Confirm}" Click="OnConfirm" IsDefault="True" />
    </StackPanel>
  </StackPanel>

</Window>
