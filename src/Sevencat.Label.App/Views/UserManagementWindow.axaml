<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Sevencat.Label.App.Localization"
        xmlns:views="using:Sevencat.Label.App.Views"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Sevencat.Label.App.Views.UserManagementWindow"
        x:DataType="views:UserManagementWindow"
        Title="{l:Loc Label.UserManagement}"
        Width="820" Height="560"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}">

  <DockPanel>

    <!-- 工具条：新建 / 刷新 在左，关闭在右 -->
    <Border DockPanel.Dock="Top" Padding="8,6"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource PanelBorderBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2">
          <Button Classes="icon accent" Click="OnNewUser" ToolTip.Tip="{l:Loc Users.New}">
            <materialIcons:MaterialIcon Kind="AccountPlus" Width="20" Height="20"
                                        Foreground="{Binding $parent[Button].Foreground}" />
          </Button>
          <Button Classes="icon" Click="OnRefresh" ToolTip.Tip="{l:Loc Common.Refresh}">
            <materialIcons:MaterialIcon Kind="Refresh" Width="20" Height="20"
                                        Foreground="{Binding $parent[Button].Foreground}" />
          </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
          <Button Classes="icon" IsCancel="True" Click="OnClose" ToolTip.Tip="{l:Loc Common.Close}">
            <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20"
                                        Foreground="{Binding $parent[Button].Foreground}" />
          </Button>
        </StackPanel>

        <TextBlock Text="{l:Loc Users.Hint}" FontSize="13" Opacity="0.65"
                   VerticalAlignment="Center" Margin="10,0,10,0"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- 底部状态 -->
    <Border DockPanel.Dock="Bottom" Padding="8,4"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource PanelBorderBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Name="StatusText" FontSize="13" Opacity="0.75"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Name="CountText" FontSize="13" Opacity="0.6"
                   VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </Border>

    <Grid Margin="8" RowDefinitions="Auto,*" RowSpacing="4">
      <!-- 表头 -->
      <Grid ColumnDefinitions="180,*,90,100,88" Margin="12,0,8,0">
        <TextBlock Grid.Column="0" Text="{l:Loc Users.FieldUserName}" FontSize="13" Opacity="0.6" />
        <TextBlock Grid.Column="1" Text="{l:Loc Users.FieldDisplayName}" FontSize="13" Opacity="0.6" />
        <TextBlock Grid.Column="2" Text="{l:Loc Users.FieldRole}" FontSize="13" Opacity="0.6" />
        <TextBlock Grid.Column="3" Text="{l:Loc Users.CreatedColumn}" FontSize="13" Opacity="0.6" />
        <TextBlock Grid.Column="4" Text="{l:Loc Users.ActionsColumn}" FontSize="13" Opacity="0.6" />
      </Grid>

      <Border Grid.Row="1" BorderThickness="1" CornerRadius="4"
              BorderBrush="{DynamicResource PanelBorderBrush}">
        <ListBox Name="UserList" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="views:UserRow">
              <Grid ColumnDefinitions="180,*,90,100,88" Margin="0,2">
                <TextBlock Grid.Column="0" Text="{Binding UserName}" FontSize="14"
                           FontFamily="Consolas,Menlo,monospace" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding RoleText}" FontSize="13" Opacity="0.7"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding CreatedText}" FontSize="13" Opacity="0.6"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2"
                            VerticalAlignment="Center">
                  <Button Classes="icon accent" Width="30" Height="30" Click="OnEditUser"
                          ToolTip.Tip="{l:Loc Users.TipEdit}">
                    <materialIcons:MaterialIcon Kind="Pencil" Width="18" Height="18"
                                                Foreground="{Binding $parent[Button].Foreground}" />
                  </Button>
                  <Button Classes="icon warn" Width="30" Height="30" Click="OnResetPassword"
                          ToolTip.Tip="{l:Loc Users.TipResetPassword}">
                    <materialIcons:MaterialIcon Kind="LockReset" Width="18" Height="18"
                                                Foreground="{Binding $parent[Button].Foreground}" />
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>
  </DockPanel>

</Window>
