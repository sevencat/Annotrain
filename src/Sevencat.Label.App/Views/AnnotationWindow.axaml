<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Sevencat.Label.App.Controls"
        x:Class="Sevencat.Label.App.Views.AnnotationWindow"
        Title="标注"
        Width="1180" Height="820"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto">

    <Border Grid.Row="0" Padding="10,8" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource MaterialDesignDivider}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,12,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <ToggleButton Grid.Column="0" x:Name="SelectTool" Content="选择" IsChecked="True" Click="OnSelectTool" />
        <ToggleButton Grid.Column="1" x:Name="RectTool" Content="矩形" Click="OnRectTool" />
        <Button Grid.Column="2" Content="适应窗口" Click="OnFit" />

        <TextBlock Grid.Column="3" Text="标签" VerticalAlignment="Center" Opacity="0.7" />
        <ComboBox Grid.Column="4" x:Name="LabelBox" IsEditable="True" MinWidth="150" />

        <TextBlock Grid.Column="5" x:Name="FileText" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="260" Opacity="0.8" />

        <Button Grid.Column="7" Content="AI 设置" Click="OnAutoLabelOptions" />
        <Button Grid.Column="8" Content="AI 标注" Click="OnAutoLabel" />
        <Button Grid.Column="9" Content="删除选中" Click="OnDelete" />
        <Button Grid.Column="10" Content="保存" Click="OnSave" IsDefault="True" />
        <Button Grid.Column="11" Content="保存并继续" Click="OnSaveAndNext" />
        <Button Grid.Column="12" Content="关闭" Click="OnClose" />
      </Grid>
    </Border>

    <controls:AnnotationCanvas Grid.Row="1" x:Name="Board" />

    <Border Grid.Row="2" Padding="10,6" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource MaterialDesignDivider}">
      <StackPanel Spacing="6">
        <StackPanel x:Name="CandidateBar" Orientation="Horizontal" Spacing="8" IsVisible="False">
          <TextBlock x:Name="CandidateText" VerticalAlignment="Center" FontWeight="SemiBold" />
          <Button Content="接受全部" Click="OnAcceptAll" />
          <Button Content="只接受 ≥0.5" Click="OnAcceptConfident" />
          <Button Content="丢弃" Click="OnDiscardCandidates" />
        </StackPanel>
        <TextBlock x:Name="HintText" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>

</Window>
