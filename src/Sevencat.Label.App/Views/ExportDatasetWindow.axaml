<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Sevencat.Label.App.Localization"
        x:Class="Sevencat.Label.App.Views.ExportDatasetWindow"
        Title="{l:Loc Export.Title}"
        Width="540" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="{l:Loc Export.Title}" FontSize="16" FontWeight="SemiBold" />
    <TextBlock Text="{l:Loc Export.Hint}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />

    <TextBlock Text="{l:Loc Export.Format}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <ComboBox x:Name="FormatBox" SelectedIndex="0" HorizontalAlignment="Stretch">
      <ComboBoxItem Content="{l:Loc Export.FormatYolo}" />
      <ComboBoxItem Content="{l:Loc Export.FormatCoco}" />
    </ComboBox>

    <TextBlock Text="{l:Loc Export.Destination}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="DestinationBox" PlaceholderText="{l:Loc Export.DestinationPlaceholder}" />
      <Button Grid.Column="1" Content="{l:Loc Common.Browse}" Click="OnBrowse" />
    </Grid>

    <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" MinHeight="16" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button Content="{l:Loc Common.Cancel}" Click="OnCancel" IsCancel="True" />
      <Button Content="{l:Loc Export.Title}" Click="OnConfirm" IsDefault="True" />
    </StackPanel>
  </StackPanel>

</Window>
