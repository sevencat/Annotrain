<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Sevencat.Label.App.Localization"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Sevencat.Label.App.Views.ResetPasswordWindow"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{l:Loc Users.ResetPassword}"
        Background="{DynamicResource PanelBackgroundBrush}">

  <StackPanel Margin="16" Spacing="8">
    <TextBlock Name="HintText" TextWrapping="Wrap" FontSize="13" Opacity="0.7" />

    <TextBlock Text="{l:Loc Users.NewPassword}" FontSize="13" Opacity="0.6" Margin="0,4,0,0" />
    <TextBox Name="NewPasswordBox" PasswordChar="●" PlaceholderText="{l:Loc Users.PasswordRule}" />

    <TextBlock Text="{l:Loc Users.ConfirmPassword}" FontSize="13" Opacity="0.6" />
    <TextBox Name="ConfirmPasswordBox" PasswordChar="●" PlaceholderText="{l:Loc Users.ConfirmPassword}" />

    <TextBlock Name="StatusText" TextWrapping="Wrap" FontSize="13" Opacity="0.75" MinHeight="16" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                Margin="0,4,0,0">
      <Button Click="OnCancel" Padding="16,4" ToolTip.Tip="{l:Loc Common.Cancel}">
        <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20"
                                    Foreground="{Binding $parent[Button].Foreground}" />
      </Button>
      <Button Click="OnSave" IsDefault="True" Padding="16,4" ToolTip.Tip="{l:Loc Users.ResetPassword}">
        <materialIcons:MaterialIcon Kind="LockReset" Width="20" Height="20"
                                    Foreground="{Binding $parent[Button].Foreground}" />
      </Button>
    </StackPanel>
  </StackPanel>

</Window>
