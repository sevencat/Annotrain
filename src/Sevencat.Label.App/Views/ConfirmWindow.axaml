<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sevencat.Label.App.Views.ConfirmWindow"
        Title="确认"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="12">
    <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold" Text="确认" />
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Opacity="0.75" FontSize="13" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button Content="取消" Click="OnCancel" IsCancel="True" />
      <Button x:Name="ConfirmButton" Content="确定" Click="OnConfirm" IsDefault="True" />
    </StackPanel>
  </StackPanel>

</Window>
