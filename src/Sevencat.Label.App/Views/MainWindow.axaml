<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sevencat.Label.App.ViewModels"
        xmlns:l="using:Sevencat.Label.App.Localization"
        xmlns:loc="using:Sevencat.Core.Localization"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Sevencat.Label.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.png"
        Width="1280" Height="840"
        MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="ListBox.plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
      <Setter Property="Padding" Value="12,0" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="8">

    <!-- 顶栏 -->
    <Border Grid.Row="0" Classes="card" Padding="12,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{l:Loc Label.Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border CornerRadius="9" Padding="8,1" Background="#1F16A34A" VerticalAlignment="Center">
            <TextBlock Text="{l:Loc Label.Running}" FontSize="13" Foreground="#16A34A" />
          </Border>
        </StackPanel>

        <!-- Web 端入口：端口 + 可打开的地址 + 打开 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding WebPortText}" FontSize="13" Opacity="0.6" VerticalAlignment="Center" />
          <TextBlock Text="{Binding WebUrl}" FontSize="13" Opacity="0.75" VerticalAlignment="Center"
                     FontFamily="Consolas,Menlo,monospace" TextTrimming="CharacterEllipsis" />
          <Button Content="{l:Loc Label.OpenWeb}" Padding="10,2" FontSize="13" Click="OnOpenWeb" />
        </StackPanel>

        <ComboBox Grid.Column="2" x:Name="LanguageBox"
                  ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                  MinWidth="124" VerticalAlignment="Center"
                  ToolTip.Tip="{l:Loc Common.Language}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="loc:LanguageOption">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Grid.Column="3" Content="{l:Loc Label.UserManagement}" Click="OnUserManagement" />
        <Button Grid.Column="4" Content="{l:Loc Label.OpenDataDir}" Click="OnOpenDataFolder" />
        <Button Grid.Column="5" Content="{l:Loc Label.About}" Click="OnAbout" />
        <Button Grid.Column="6" Content="{l:Loc Label.Log}" Click="OnOpenLog" />
      </Grid>
    </Border>

    <!-- 主体：左项目 / 右概览 + 图片清单 -->
    <Grid Grid.Row="1" ColumnDefinitions="290,*" ColumnSpacing="12">

      <!-- 左：项目管理 -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Border Grid.Row="0" Classes="card" Padding="12,10">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{l:Loc Label.Projects}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Classes="badge" Background="#14000000">
                  <TextBlock Text="{Binding VisibleProjects.Count}" FontSize="12" Opacity="0.7" />
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="icon" Click="OnCreateProject" ToolTip.Tip="{l:Loc Label.NewProject}">
                  <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18" />
                </Button>
                <Button Classes="icon" Click="OnRefresh" ToolTip.Tip="{l:Loc Common.Refresh}">
                  <materialIcons:MaterialIcon Kind="Refresh" Width="18" Height="18" />
                </Button>
              </StackPanel>
            </Grid>

            <!-- 项目可能上千条：搜索收窄 + ListBox 默认虚拟化 -->
            <TextBox Grid.Row="1" Text="{Binding ProjectFilter, Mode=TwoWay}"
                     PlaceholderText="{l:Loc Label.ProjectSearch}"
                     FontSize="13" MinHeight="32" VerticalContentAlignment="Center" />
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
          <ListBox Classes="plain" ItemsSource="{Binding VisibleProjects}"
                   SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectSummaryViewModel">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,8">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                    <Border Classes="badge" Background="#1FF59E0B" IsVisible="{Binding IsClosed}">
                      <TextBlock Text="{l:Loc Label.Closed}" FontSize="12" Foreground="#D97706" />
                    </Border>
                  </StackPanel>

                  <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat='{}{0:P0}'}"
                             FontSize="13" Opacity="0.5" VerticalAlignment="Center" />

                  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,3,0,0">
                    <TextBlock Text="{Binding CreatedLabel}" Classes="caption" />
                    <TextBlock Text="{Binding ImageCountText}" Classes="caption" />
                    <TextBlock Text="{Binding LabeledCountText}" Classes="caption" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="13" Opacity="0.7"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
      </Grid>

      <!-- 右：概览 + 清单 -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">

        <!-- 概览：项目名 / 进度统计 / 描述 / 动作按钮 -->
        <Border Grid.Row="0" Classes="card" Padding="14,12" IsVisible="{Binding HasProject}">
          <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                RowSpacing="6" ColumnSpacing="12">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ProjectTitle}"
                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="420" />

            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="160,*" ColumnSpacing="10"
                  VerticalAlignment="Center">
              <ProgressBar Grid.Column="0" Height="6" Minimum="0" Maximum="100"
                           VerticalAlignment="Center" Value="{Binding ProjectProgress}"
                           ToolTip.Tip="{Binding ProjectStats}" />
              <TextBlock Grid.Column="1" Text="{Binding ProjectStats}" FontSize="13" Opacity="0.6"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Classes="badge" Background="#1F16A34A" IsVisible="{Binding !IsProjectClosed}">
                <TextBlock Text="{l:Loc Label.InProgress}" FontSize="12" Foreground="#16A34A" />
              </Border>
              <Border Classes="badge" Background="#14000000" IsVisible="{Binding IsProjectClosed}">
                <TextBlock Text="{l:Loc Label.Closed}" FontSize="12" Opacity="0.7" />
              </Border>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding ProjectDescription}"
                       FontSize="13" Opacity="0.7" TextWrapping="Wrap" MaxLines="2"
                       TextTrimming="CharacterEllipsis" />

            <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" ItemSpacing="8" Margin="0,4,0,0">
              <!-- 标注流程 -->
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="icon success" Click="OnStartAnnotation" ToolTip.Tip="{l:Loc Label.StartAnnotation}">
                  <materialIcons:MaterialIcon Kind="Play" Width="18" Height="18" />
                </Button>
                <Button Classes="icon warn" Click="OnToggleClosed" IsVisible="{Binding !IsProjectClosed}"
                        ToolTip.Tip="{l:Loc Label.ToggleClosed}">
                  <materialIcons:MaterialIcon Kind="Archive" Width="18" Height="18" />
                </Button>
                <Button Classes="icon warn" Click="OnToggleClosed" IsVisible="{Binding IsProjectClosed}"
                        ToolTip.Tip="{l:Loc Label.ToggleClosed}">
                  <materialIcons:MaterialIcon Kind="Restore" Width="18" Height="18" />
                </Button>
              </StackPanel>

              <Border Width="1" Height="20" Background="{DynamicResource PanelBorderBrush}" Margin="2,0" />

              <!-- 项目设置 -->
              <Button Classes="icon info" Click="OnEditProject" ToolTip.Tip="{l:Loc Label.EditProject}">
                <materialIcons:MaterialIcon Kind="Pencil" Width="18" Height="18" />
              </Button>

              <Border Width="1" Height="20" Background="{DynamicResource PanelBorderBrush}" Margin="2,0" />

              <!-- 危险 -->
              <Button Classes="icon danger" Click="OnDeleteProject" ToolTip.Tip="{l:Loc Label.DeleteProject}">
                <materialIcons:MaterialIcon Kind="Delete" Width="18" Height="18" />
              </Button>

              <Border Width="1" Height="20" Background="{DynamicResource PanelBorderBrush}" Margin="2,0" />

              <!-- 图片入库 -->
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="icon teal" Click="OnImportImages" ToolTip.Tip="{l:Loc Label.ImportImages}">
                  <materialIcons:MaterialIcon Kind="ImagePlus" Width="18" Height="18" />
                </Button>
                <Button Classes="icon teal" Click="OnImportFolder" ToolTip.Tip="{l:Loc Label.ImportFolder}">
                  <materialIcons:MaterialIcon Kind="FolderPlus" Width="18" Height="18" />
                </Button>
                <Button Classes="icon teal" Click="OnScanFolder" ToolTip.Tip="{l:Loc Label.ScanFolder}">
                  <materialIcons:MaterialIcon Kind="FolderSearch" Width="18" Height="18" />
                </Button>
              </StackPanel>

              <Border Width="1" Height="20" Background="{DynamicResource PanelBorderBrush}" Margin="2,0" />

              <!-- 产出 -->
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="icon violet" Click="OnImportDataset" ToolTip.Tip="{l:Loc Label.ImportDataset}">
                  <materialIcons:MaterialIcon Kind="DatabaseImport" Width="18" Height="18" />
                </Button>
                <Button Classes="icon violet" Click="OnExportDataset" ToolTip.Tip="{l:Loc Label.ExportDataset}">
                  <materialIcons:MaterialIcon Kind="DatabaseExport" Width="18" Height="18" />
                </Button>
                <Button Classes="icon violet" Click="OnOpenProjectFolder" ToolTip.Tip="{l:Loc Label.OpenFolder}">
                  <materialIcons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
                </Button>
              </StackPanel>

              <Border Width="1" Height="20" Background="{DynamicResource PanelBorderBrush}" Margin="2,0" />

              <!-- 类别 -->
              <Button Classes="icon amber" Click="OnManageClasses" ToolTip.Tip="{Binding CategoryText}">
                <materialIcons:MaterialIcon Kind="Tag" Width="18" Height="18" />
              </Button>
            </WrapPanel>
          </Grid>
        </Border>

        <!-- 图片清单：表头 / 行 / 分页 -->
        <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
          <Grid RowDefinitions="Auto,Auto,*,Auto">

            <Grid Grid.Row="0" ColumnDefinitions="44,*,44,44,96,120,*,44" ColumnSpacing="8" Margin="12,8">
              <TextBlock Grid.Column="0" Text="{l:Loc Label.ColumnThumb}" Classes="caption" />
              <TextBlock Grid.Column="1" Text="{l:Loc Label.ColumnPath}" Classes="caption" />
              <TextBlock Grid.Column="2" Text="{l:Loc Label.ColumnLabel}" Classes="caption" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="{l:Loc Label.ColumnSplit}" Classes="caption" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{l:Loc Label.ColumnAnnotator}" Classes="caption" />
              <TextBlock Grid.Column="5" Text="{l:Loc Label.ColumnAnnotatedAt}" Classes="caption" />
              <TextBlock Grid.Column="6" Text="{l:Loc Label.ColumnRemark}" Classes="caption" />
              <TextBlock Grid.Column="7" Text="{l:Loc Label.ColumnActions}" Classes="caption" HorizontalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource PanelBorderBrush}" />

            <ListBox Grid.Row="2" Classes="plain" ItemsSource="{Binding Images}"
                     SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                     DoubleTapped="OnRowDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProjectImageViewModel">
                  <Grid ColumnDefinitions="44,*,44,44,96,120,*,44" ColumnSpacing="8" Margin="0,5">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="3"
                            Background="#12000000" ClipToBounds="True">
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding DisplayPath}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayPath}" />

                    <TextBlock Grid.Column="2" Text="✓" IsVisible="{Binding HasAnnotation}"
                               Foreground="#16A34A" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               ToolTip.Tip="{l:Loc Label.HasAnnotationTip}" />
                    <TextBlock Grid.Column="2" Text="—" IsVisible="{Binding !HasAnnotation}"
                               Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <materialIcons:MaterialIcon Grid.Column="3" Kind="{Binding SplitIcon}"
                                                Width="21" Height="21" Foreground="{Binding SplitColor}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding SplitTip}" />

                    <TextBlock Grid.Column="4" Text="{Binding AnnotatorText}" FontSize="13" Opacity="0.75"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding AnnotatorText}" />

                    <TextBlock Grid.Column="5" Text="{Binding AnnotatedAtText}" FontSize="13" Opacity="0.55"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="6" Text="{Binding RemarkText}" FontSize="13" Opacity="0.6"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding RemarkText}" />

                    <Button Grid.Column="7" Classes="icon" Tag="{Binding}"
                            Click="OnImageActionMenu" ToolTip.Tip="{l:Loc Label.RowMenuTip}">
                      <materialIcons:MaterialIcon Kind="DotsVertical" Width="18" Height="18" />
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{l:Loc Label.AnnotateAction}" Click="OnAnnotateImageAction" />
                          <MenuItem Header="{l:Loc Label.ResetState}" Click="OnResetImageState" />
                          <MenuItem Header="{l:Loc Label.ClearAnnotation}" Click="OnClearAnnotation" />
                          <MenuItem Header="{l:Loc Label.DeleteImage}" Click="OnDeleteImage" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelBorderBrush}">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="12,8">
                <Button Grid.Column="0" Classes="icon" Click="OnPrevPage" IsEnabled="{Binding CanPrevPage}"
                        ToolTip.Tip="{l:Loc Label.PrevPage}">
                  <materialIcons:MaterialIcon Kind="ChevronLeft" Width="18" Height="18" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding PageText}" FontSize="13" Opacity="0.7"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding TotalText}" FontSize="13" Opacity="0.6"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" HorizontalAlignment="Right" Classes="icon"
                        Click="OnNextPage" IsEnabled="{Binding CanNextPage}"
                        ToolTip.Tip="{l:Loc Label.NextPage}">
                  <materialIcons:MaterialIcon Kind="ChevronRight" Width="18" Height="18" />
                </Button>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- 底栏：数据库位置 + 软件信息（日志在右上角按钮里） -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Text="{Binding FooterText}" FontSize="13" Opacity="0.55" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DatabasePath}" />

      <TextBlock Grid.Column="1" Text="{Binding ProductInfoText}" FontSize="13" Opacity="0.45"
                 VerticalAlignment="Center" ToolTip.Tip="{Binding ProductInfoText}" />
    </Grid>
  </Grid>
</Window>
