<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sevencat.Label.App.ViewModels"
        x:Class="Sevencat.Label.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.png"
        Width="1440" Height="900"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,*,160">

    <!-- 顶部：数据目录 -->
    <Border Grid.Row="0" Padding="12,10" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource MaterialDesignDivider}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" Content="打开数据目录…" Click="OnOpenWorkspace" />
        <TextBlock Grid.Column="1" Text="{Binding DataDirectory}" Margin="4,0"
                   VerticalAlignment="Center" Opacity="0.7"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Content="刷新" Click="OnRefresh" />
        <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center"
                   Opacity="0.7" MaxWidth="380" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <!-- 主体：左项目管理 / 右项目明细 -->
    <Grid Grid.Row="1" ColumnDefinitions="300,*">

      <!-- 左：项目管理 -->
      <Border Grid.Column="0" BorderThickness="0,0,1,0"
              BorderBrush="{DynamicResource MaterialDesignDivider}">
        <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="8">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <TextBlock Text="项目管理" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="新建" Click="OnCreateProject" />
            <Button Grid.Column="2" Content="导入数据集" Click="OnImport" />
          </Grid>

          <TextBlock Grid.Row="1" Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                     Text="标注只认数据库形态；YOLO / RF-DETR 通过导入进来、通过导出出去。" />

          <ListBox Grid.Row="2" ItemsSource="{Binding Projects}"
                   SelectedItem="{Binding SelectedProject}"
                   BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectSummaryViewModel">
                <StackPanel Spacing="2" Margin="0,3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Stats}" FontSize="11" Opacity="0.7" />
                  <TextBlock Text="{Binding Splits}" FontSize="11" Opacity="0.5" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- 右：项目明细（图片表格） -->
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding ProjectTitle}" FontWeight="SemiBold" FontSize="15"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="1" Content="开始标注" Click="OnStartAnnotation" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,70,90,70,64" ColumnSpacing="8" Margin="12,0,12,0">
          <TextBlock Text="文件" FontSize="11" Opacity="0.55" />
          <TextBlock Grid.Column="1" Text="split" FontSize="11" Opacity="0.55" />
          <TextBlock Grid.Column="2" Text="尺寸" FontSize="11" Opacity="0.55" />
          <TextBlock Grid.Column="3" Text="标注" FontSize="11" Opacity="0.55" />
          <TextBlock Grid.Column="4" Text="操作" FontSize="11" Opacity="0.55" />
        </Grid>

        <ListBox Grid.Row="2" ItemsSource="{Binding Images}"
                 SelectedItem="{Binding SelectedImage}"
                 BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectImageViewModel">
              <Grid ColumnDefinitions="*,70,90,70,64" ColumnSpacing="8" Margin="0,2">
                <TextBlock Grid.Column="0" Text="{Binding FileName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Split}" VerticalAlignment="Center" Opacity="0.7" />
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" Opacity="0.7" />
                <TextBlock Grid.Column="3" Text="{Binding BoxText}" VerticalAlignment="Center" Opacity="0.7" />
                <Button Grid.Column="4" Content="标注" Padding="8,2" Click="OnAnnotateRow" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>

    <!-- 日志 -->
    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}"
            Background="{DynamicResource MaterialDesignBackground}">
      <DockPanel Margin="12,8">
        <TextBlock DockPanel.Dock="Top" Text="日志" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Consolas,Menlo,monospace" FontSize="12"
                 TextWrapping="NoWrap" VerticalContentAlignment="Top"
                 Background="Transparent" BorderThickness="0" />
      </DockPanel>
    </Border>
  </Grid>

</Window>
