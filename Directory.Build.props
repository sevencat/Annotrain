<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>Sevencat</Company>
    <Product>Annotrain</Product>
    <Version>0.1.0</Version>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 只支持 Windows x64：进程固定 64 位，产物固定 win-x64（框架依赖，不自带运行时） -->
  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- 分层约定见 docs/MISC.md：Core / Label / Train.Engine 不得引用 Avalonia -->

</Project>
